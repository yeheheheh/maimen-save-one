# 麦门省一单服务端配置
PORT=8899
HOST=127.0.0.1

# 麦当劳 MCP Token：只放在服务端，不下发给浏览器
MCD_MCP_TOKEN=
MCD_MCP_URL=https://mcp.mcd.cn

# 实时 MCP 模式（需要有效 Token）
ENABLE_LIVE=false

# 演示写操作：默认开启，仅模拟领券/下单/取消，不会触动真实账户
DEMO_WRITE=true

# 实时写操作必须同时满足：ENABLE_WRITE=true + SINGLE_USER_MODE=true + WRITE_PASSCODE
SINGLE_USER_MODE=false
ENABLE_WRITE=false
ENABLE_COUPON_CLAIM=false
ENABLE_ORDER_CREATE=false
ENABLE_AUTO_REPURCHASE=false
ENABLE_AUTO_CANCEL_UNPAID=false

# 金额与频次上限（单位：分）
MAX_ORDER_CENTS=5000
MAX_DAILY_ORDERS=5
SUBSCRIPTION_TICK_MS=60000

# 私有模式口令；不要提交到 Git
WRITE_PASSCODE=
SESSION_SECRET=
# RUNTIME_DATA_FILE=./data/runtime.json

# 单次 MCP 工具调用超时
MCP_TOOL_TIMEOUT_MS=15000
